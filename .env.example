# WebShop Pro lokális lab — alapértelmezett értékek.
# Másold át .env-re, ha felül akarod írni a portokat vagy a kredeket.
#
# A docker-compose.yml automatikusan beolvassa a .env fájlt, ha létezik.

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=webshop
POSTGRES_USER=webshop
POSTGRES_PASSWORD=webshop

# ─── MinIO (S3-kompatibilis tárolás) ───────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Airflow ───────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ─── LLM provider API kulcsok (csak az AI/RAG kurzusokhoz) ─────
# Hagyd üresen, ha csak helyi modelleket vagy mock-ot használsz.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Opcionális: Hugging Face cache (RAG eval kurzushoz) ───────
HF_HOME=
HUGGINGFACE_HUB_CACHE=

# ─── Spark heap (lokális fejlesztéshez érdemes alacsonyabbra) ──
SPARK_MASTER_MEMORY=1g
SPARK_WORKER_MEMORY=1g
