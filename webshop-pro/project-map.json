{
  "name": "WebShop Pro",
  "purpose": "Közös oktatási esettanulmány Data és AI Engineering kurzusokhoz",
  "business_questions": [
    "Melyik csatorna hozza a legtöbb bevételt?",
    "Melyik terméknél fogy el hamar a készlet?",
    "Melyik ügyfél valószínűleg lemorzsolódik?",
    "Milyen választ adjon az AI ügyfélszolgálat a webshop szabályzata alapján?",
    "Mely adatok tartalmaznak PII-t, ki férhet hozzájuk, és melyik domén felel értük?",
    "Mely ügyfélszolgálati kérdések válaszolhatók meg biztonságosan lokális LLM-mel, és mikor kell cloud fallback?"
  ],
  "layers": [
    {"layer": "source", "examples": ["orders.json", "events.json", "catalog.json"]},
    {"layer": "bronze", "examples": ["nyers rendelések", "nyers clickstream"]},
    {"layer": "silver", "examples": ["tisztított rendelés", "validált termékkatalógus"]},
    {"layer": "gold", "examples": ["napi KPI", "ügyfél feature tábla", "termék teljesítmény"]},
    {"layer": "governance", "examples": ["PII osztályozás", "lineage", "audit policy"]},
    {"layer": "data-product", "examples": ["sales mart", "support dataset", "domain SLA"]},
    {"layer": "ai", "examples": ["RAG support bot", "agentic support flow", "churn score", "prompt eval", "local LLM gateway"]},
    {"layer": "ops", "examples": ["Airflow DAG", "MLflow run", "Grafana dashboard", "local LLM benchmark"]}
  ],
  "docker_lab": {
    "compose_file": "docker-compose.yml",
    "start": "docker compose up -d --build",
